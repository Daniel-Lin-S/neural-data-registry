#!/bin/sh

set -eu
umask 027

cd @SERVICE_HOME@

case "${1-}" in
    ingest-local|unregister|reregister)
        printf "Use the protected public brainctl wrapper for %s.\n" "$1" >&2
        exit 2
        ;;
esac

exec @ENV_PATH@ -i \
    HOME=@SERVICE_HOME@ \
    PATH=@SAFE_PATH@ \
    PYTHONNOUSERSITE=1 \
    NDR_DATA_ROOT=@DATA_ROOT@ \
    NDR_DATABASE_URL=@DATABASE_URL@ \
    NDR_STARTUP_HEALTH_CHECK_ENABLED=false \
    @CLI_PATH@ "$@"
