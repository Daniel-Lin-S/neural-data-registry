# Copy to reference_ingest.local.env, fill every placeholder, then set mode 600.
# The .local.env file is intentionally ignored and must be root-owned.

NDR_DATA_ROOT=/ABSOLUTE/PATH/TO/MANAGED_REGISTRY
NDR_SOURCE_ROOTS=/ABSOLUTE/PATH/TO/SOURCE_ROOT_ONE:/ABSOLUTE/PATH/TO/SOURCE_ROOT_TWO
NDR_RUNTIME_ROOT=/ABSOLUTE/PATH/TO/ROOT_OWNED_RUNTIME
NDR_SERVICE_USER=SERVICE_ACCOUNT_NAME
NDR_SERVICE_GROUP=SERVICE_ACCOUNT_GROUP
NDR_SERVICE_HOME=/ABSOLUTE/PATH/TO/SERVICE_HOME
NDR_SERVICE_SHELL=/ABSOLUTE/PATH/TO/NOLOGIN_SHELL
NDR_PUBLIC_BRAINCTL_PATH=/ABSOLUTE/PATH/TO/PUBLIC_BRAINCTL
NDR_HELPER_PATH=/ABSOLUTE/PATH/TO/PRIVILEGED_HELPER
NDR_SUDOERS_PATH=/ABSOLUTE/PATH/TO/SUDOERS_FRAGMENT
NDR_SAFE_PATH=/ABSOLUTE/PATH/TO/SYSTEM_BINARIES

# Optional. When omitted, the installer derives a SQLite URL from NDR_DATA_ROOT.
# NDR_DATABASE_URL=sqlite:////ABSOLUTE/PATH/TO/MANAGED_REGISTRY/registry/registry.db
